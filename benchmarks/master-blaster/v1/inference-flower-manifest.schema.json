{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xnet.local/schemas/inference-flower-manifest.v1.json",
  "title": "XNET reference-only four-role Flower manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "authority_id", "policy_sha256", "purpose", "evidence_epoch",
    "valid_through_evidence_epoch", "content_embedded", "benchmark_feedback_allowed",
    "seven_gates_required", "operational_authority_granted", "seven_gates_receipt_sha256s",
    "role_anchors", "receipt_sha256", "receipt_hmac_sha256"
  ],
  "properties": {
    "schema_version": {"const": "xnet.inference-flower-manifest.v1"},
    "authority_id": {"$ref": "#/$defs/identifier"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "purpose": {"const": "post-evaluation-routing"},
    "evidence_epoch": {"type": "integer", "minimum": 1},
    "valid_through_evidence_epoch": {"type": "integer", "minimum": 1},
    "content_embedded": {"const": false},
    "benchmark_feedback_allowed": {"const": false},
    "seven_gates_required": {"const": true},
    "operational_authority_granted": {"const": false},
    "seven_gates_receipt_sha256s": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "role_anchors": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/solver"},
        {"$ref": "#/$defs/verifier"},
        {"$ref": "#/$defs/challenger"},
        {"$ref": "#/$defs/synthesizer"}
      ],
      "items": false
    },
    "receipt_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_hmac_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]{0,127}$"},
    "anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "decision_receipt_sha256", "artifact_sha256", "source_metric_receipt_sha256"],
      "properties": {
        "role": {"type": "string"},
        "decision_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "source_metric_receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "solver": {"allOf": [{"$ref": "#/$defs/anchor"}, {"properties": {"role": {"const": "solver"}}}]},
    "verifier": {"allOf": [{"$ref": "#/$defs/anchor"}, {"properties": {"role": {"const": "verifier"}}}]},
    "challenger": {"allOf": [{"$ref": "#/$defs/anchor"}, {"properties": {"role": {"const": "challenger"}}}]},
    "synthesizer": {"allOf": [{"$ref": "#/$defs/anchor"}, {"properties": {"role": {"const": "synthesizer"}}}]}
  }
}
